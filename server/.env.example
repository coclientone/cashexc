PORT=4242
# Server-only secret; never expose or commit this value.
STRIPE_SECRET_KEY=sk_test_replace_me
# Obtain from: stripe listen --forward-to localhost:4242/api/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Safe to expose in the browser only when using a publishable pk_test key.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Set this to the exact origin hosting payment.html in production.
FRONTEND_ORIGIN=http://localhost:4242
